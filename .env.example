# ZapTheTrick backend — environment template.
# Copy to `.env` (gitignored) and fill in. On RunPod, set these same keys as
# TEMPLATE ENV VARIABLES instead — a real env var always overrides the .env file.

# ── Accounts (vNext §10.1c) ────────────────────────────────────────────────
# HMAC secret that signs session JWTs. Use a long random string (>=32 chars),
# e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep it STABLE — changing it signs everyone out. Leave unset to disable
# native accounts (app falls back to the per-device local stub).
ZAPTHETRICK_AUTH_SECRET=

# Auth plane: native | supabase | off.  Use "native" for self-hosted accounts.
ZAPTHETRICK_AUTH_MODE=native

# Login WALL: "1" = an unauthenticated request is rejected (recommended on the
# exposed RunPod pod). Leave unset/0 locally so accounts are optional.
# ZAPTHETRICK_AUTH_ENFORCE=1

# ── Google sign-in ("Continue with Google") ────────────────────────────────
# Google Cloud → Credentials → OAuth client ID → application type "Desktop app".
# Leave both blank to hide the Google button (email/password still works).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Email verification (SMTP) ──────────────────────────────────────────────
# Registration sends a verify link; the account can't log in until it's clicked.
# Gmail: enable 2-Step Verification, then create an App Password and use it as
# SMTP_PASSWORD (NOT your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
SMTP_FROM=ZapTheTrick <you@gmail.com>
# STARTTLS on 587 (default). For implicit TLS on port 465, set SMTP_SSL=1.
# SMTP_SSL=0

# Externally-reachable base URL of THIS backend, used to build the verify link
# in the email. Leave blank locally (derived from the request); set to your pod
# URL on RunPod so the link works from the user's email client.
ZAPTHETRICK_PUBLIC_URL=

# Set to 0 ONLY for local dev with no SMTP (auto-verifies, skips email).
# ZAPTHETRICK_REQUIRE_EMAIL_VERIFICATION=1
